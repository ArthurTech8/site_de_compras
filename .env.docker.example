# Copie para .env (na mesma pasta do docker-compose.yml) e preencha. O .env não vai para o git.

# Primeiro administrador, criado quando a API sobe e ainda não existe nenhum admin.
ADMIN_NOME=Administrador
ADMIN_EMAIL=voce@exemplo.com
ADMIN_SENHA=troque-por-uma-senha-longa

# Porta do site no seu computador (http://localhost:8080).
PORTA_SITE=8080

# Pasta do repositório do backend, se não estiver ao lado deste.
# BACKEND_DIR=../Site_de_Compras_Backend
